amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

local mise_globs = List(
  ".mise/config.toml",
  "**/.mise.toml",
  "**/.mise.*.toml"
)

local ci_prefix = List("mise", "x", "--")

local ci_env = new Mapping<String, String> {
  ["MISE_ENV"] = "ci"
}

local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) { prefix = ci_prefix; env = ci_env }
  ["yamllint"] = (Builtins.yamllint) { prefix = ci_prefix; env = ci_env }
  ["pinact"] = (Builtins.pinact) { prefix = ci_prefix; env = ci_env }
  ["mise"] = (Builtins.mise) {
    glob = mise_globs
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
